name: Build

on:
  push:
    branches: [ "main", "master" ]
  workflow_dispatch:

concurrency:
  group: "build"
  cancel-in-progress: true

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          java-version: '17'
          distribution: 'temurin'

      - name: Setup Android SDK
        uses: android-actions/setup-android@v3

      - name: Setup Gradle
        uses: gradle/actions/setup-gradle@v4

      - name: Build plugins
        run: ./gradlew make --stacktrace

      - name: Push builds
        run: |
          cd $GITHUB_WORKSPACE/builds || cd $GITHUB_WORKSPACE/app/build || true
          cd $GITHUB_WORKSPACE
          git config --local user.email "actions@github.com"
          git config --local user.name "GitHub Actions"
          git fetch origin builds || true
          git checkout --orphan builds-temp || git checkout builds || git checkout --orphan builds-temp
          rm -rf * || true
          git checkout main -- . 2>/dev/null || git checkout master -- . 2>/dev/null || true
          if [ -d "builds" ]; then
            cp -r builds/. .
            git add -A
            git commit -m "Build plugins" || echo "Nothing to commit"
            git push origin HEAD:builds --force
          else
            echo "No builds directory found"
          fi
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
